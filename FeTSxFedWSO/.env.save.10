########################################
# gRPC Network Keepalive Settings
########################################
GRPC_ARG_KEEPALIVE_TIMEOUT_MS=600000

########################################
# Flower Server Address & Port
########################################
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8089

########################################
# Dataset Root Folder (FeTS2022)
########################################
DATA_PATH=/home/jovyan/FeTS2022/MICCAI_FeTS2022_TrainingData

########################################
# FedWSOComp Compression Mode
# SKH = Sparsification + KMeans + Huffman (Full)
# SH  = Sparsification + Huffman (no KMeans)
# KH  = KMeans + Huffman (no Sparsification)
########################################
ENCODING_MODE=Fedavg
#N_CLUSTERS=3
#ENCODING_MODE=SH
#N_CLUSTERS=64
#SPARSITY_CONV=0.60
#SPARSITY_LINEAR=0.60
#SPARSITY_BIAS=0.0
#SPARSITY_BN=0.0
########################################
# Transport Mode (gRPC)
########################################
TRANSPORT_MODE=grpc

